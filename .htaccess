# ============================================================
# CBZ-Viewer — Apache configuration
# ============================================================

# Disable directory listing
Options -Indexes

# Block direct HTTP access to data and cache directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data(/.*)?$  - [F,L]
    RewriteRule ^cache(/.*)?$ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always set Referrer-Policy         "no-referrer-when-downgrade"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 week"
    ExpiresByType application/javascript   "access plus 1 week"
    ExpiresByType image/jpeg               "access plus 1 hour"
    ExpiresByType image/png                "access plus 1 hour"
    ExpiresByType image/webp               "access plus 1 hour"
    ExpiresByType image/gif                "access plus 1 hour"
</IfModule>

# PHP settings
# LiteSpeed LSAPI (Server API: LiteSpeed) lit les php_value/php_flag
# directement dans .htaccess, sans bloc <IfModule mod_php.c>.
# Sur Apache+mod_php ces directives fonctionnent aussi nativement.
php_value memory_limit            512M
php_value max_execution_time      360
php_flag  display_errors          Off
php_flag  display_startup_errors  Off
php_flag  zlib.output_compression Off
php_flag  log_errors              On
php_value error_reporting         32767
# Chemin relatif à la racine du site — fonctionne sur LiteSpeed et Apache.
# Si les logs n'apparaissent pas, remplacez par le chemin absolu (non commité).
php_value error_log               logs/php-errors.log
# Pour afficher les erreurs dans les pages (debug uniquement) :
# php_flag  display_errors          On

# Prevent any encoding or compression for the binary image streaming endpoint
<FilesMatch "page\.php">
    # Tell mod_deflate and mod_brotli to skip this response
    SetEnv no-gzip 1
    SetEnv no-brotli 1
    <IfModule mod_headers.c>
        # Remove any Content-Encoding header Apache might add
        Header always unset Content-Encoding
        Header always unset Transfer-Encoding
    </IfModule>
</FilesMatch>
