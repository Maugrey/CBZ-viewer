# Ignore all files in data directory
data/**

# But keep .gitkeep files and README
!data/**/.gitkeep
!data/**/README.md

# Ignore generated cache files, but keep the directory stubs
cache/**
!cache/.htaccess
!cache/thumbnails/.gitkeep
!cache/metadata/.gitkeep

# Ignore PHP error log but keep the directory stub
logs/*.log
logs/*.log.*

# Si vous devez surcharger .htaccess avec des chemins absolus (error_log, etc.),
# créez un fichier .htaccess.local — jamais commité.
.htaccess.local
